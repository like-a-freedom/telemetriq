{
  "name": "telemetriq",
  "private": true,
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "test:coverage": "vitest run --coverage",
    "test:performance": "bun vitest run src/__tests__/videoProcessingPerformance.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint --max-warnings=0 \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint --max-warnings=0 \"src/**/*.{js,ts,vue}\" --fix",
    "fetch-ffmpeg-core": "bun scripts/fetch-ffmpeg-core.js",
    "test:e2e:pages": "playwright test --config=playwright.pages.config.ts"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "@webgpu/types": "^0.1.74",
    "agent-browser": "^0.41.2",
    "mediabunny": "^1.65.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "trustedDependencies": [
    "agent-browser",
    "edgedriver"
  ]
}
