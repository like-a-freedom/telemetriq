{
  "name": "telemetriq",
  "private": true,
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "test:coverage": "vitest run --coverage",
    "test:performance": "bun vitest run src/__tests__/videoProcessingPerformance.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint --max-warnings=0 \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint --max-warnings=0 \"src/**/*.{js,ts,vue}\" --fix",
    "fetch-ffmpeg-core": "mkdir -p public/vendor/ffmpeg && curl -fL https://cdn.jsdelivr.net/npm/@ffmpeg/core@latest/dist/esm/ffmpeg-core.js -o public/vendor/ffmpeg/ffmpeg-core.js && curl -fL https://cdn.jsdelivr.net/npm/@ffmpeg/core@latest/dist/esm/ffmpeg-core.wasm -o public/vendor/ffmpeg/ffmpeg-core.wasm"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@unhead/vue": "^3.4.1",
    "@vueuse/core": "^15.0.0",
    "@webgpu/types": "^0.1.72",
    "agent-browser": "^0.38.1",
    "mediabunny": "^1.58.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "trustedDependencies": [
    "agent-browser",
    "edgedriver"
  ]
}